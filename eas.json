{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "apk": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal"
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "autoIncrement": true
      },
      "buildHooks": {
        "preInstall": "./eas-hooks/eas-build-pre-install.sh"
      }
    },
    "store": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "autoIncrement": true
      },
      "buildHooks": {
        "preInstall": "./eas-hooks/eas-build-pre-install.sh"
      }
    },
    "ios-preview": {
      "ios": {
        "simulator": false,
        "distribution": "internal"
      },
      "buildHooks": {
        "preInstall": "./eas-hooks/eas-build-pre-install.sh"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
